<Window x:Class="Hover.Card"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hover" Width="480" MaxHeight="680" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False"
        Background="#202020" Foreground="White" FontFamily="Segoe UI Variable Text" FontSize="13"
        UseLayoutRounding="True">

    <Window.Resources>
        <SolidColorBrush x:Key="Muted" Color="#9D9D9D"/>
        <SolidColorBrush x:Key="Accent" Color="#60CDFF"/>
        <SolidColorBrush x:Key="Field" Color="#2D2D2D"/>
        <SolidColorBrush x:Key="Edge" Color="#3A3A3A"/>

        <!-- Footer actions look like quiet text links that light up on hover. -->
        <Style x:Key="TextButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="7,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- Empty areas of this panel drag the card (see OnMouseLeftButtonDown). -->
    <DockPanel Margin="18,14" Background="Transparent">
        <TextBlock x:Name="TitleText" DockPanel.Dock="Top" FontFamily="Segoe UI Variable Display Semibold"
                   FontSize="17" TextTrimming="CharacterEllipsis"/>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Copy" Style="{StaticResource TextButton}" Click="OnCopy" ToolTip="Ctrl+C"/>
                <Button Content="Replace" Style="{StaticResource TextButton}" Click="OnReplace" ToolTip="Ctrl+R"/>
                <Button x:Name="PinButton" Content="Pin" Style="{StaticResource TextButton}" Click="OnPin"
                        ToolTip="Ctrl+P: keep it open as a normal window (Snap works)"/>
            </StackPanel>
            <TextBlock x:Name="Status" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" MouseLeftButtonUp="OnStatusClick"/>
        </DockPanel>

        <Border DockPanel.Dock="Bottom" Margin="0,8,0,0" Background="{StaticResource Field}" CornerRadius="4"
                BorderBrush="{StaticResource Edge}" BorderThickness="1">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="&#xE720;" FontFamily="Segoe Fluent Icons" FontSize="14"
                        Style="{StaticResource TextButton}" Padding="8,0" VerticalAlignment="Center"
                        Click="OnMic" ToolTip="Ctrl+M: say a follow-up (Windows voice typing)"/>
                <TextBox x:Name="FollowUpBox" Background="Transparent" Foreground="White" CaretBrush="White"
                         BorderThickness="0" Padding="6,5" KeyDown="OnFollowUpKey"/>
            </DockPanel>
        </Border>

        <RichTextBox x:Name="Body" Margin="0,6,0,0" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                     Foreground="White" Padding="-5,0" VerticalScrollBarVisibility="Auto"
                     SelectionBrush="{StaticResource Accent}" Cursor="Arrow">
            <FlowDocument PagePadding="0" LineHeight="20"/>
        </RichTextBox>
    </DockPanel>
</Window>
