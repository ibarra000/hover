<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The Windows 10 SDK version unlocks Windows.Media.Ocr (WinRT) directly from C#. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms> <!-- only for the tray icon (NotifyIcon) -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Hover</AssemblyName>
    <RootNamespace>Hover</RootNamespace>
    <Version>2.0.0</Version>
    <ApplicationIcon>..\..\hover.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier> <!-- framework-dependent, but only the x64 native SQLite -->
    <SelfContained>false</SelfContained>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType> <!-- no .pdb in the MSI -->
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF and WinForms both define Application, Clipboard, ... : keep WinForms out of the global usings. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Resource Include="..\..\hover.ico" Link="hover.ico" />
    <InternalsVisibleTo Include="Hover.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
  </ItemGroup>

</Project>
